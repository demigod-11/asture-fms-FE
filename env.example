# API Configuration (backend base URL including version, e.g. /api/v1)
VITE_API_URL=http://localhost:8000/api/v1

# Frontend app origin (this app’s public URL – for redirects, OAuth callbacks, etc.)
VITE_APP_URL=http://localhost:3000

VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=true

# External Services
VITE_SENTRY_DSN=
VITE_GOOGLE_ANALYTICS_ID=

# App Configuration
VITE_APP_NAME="Asture FMS"
VITE_APP_VERSION=0.1.0 